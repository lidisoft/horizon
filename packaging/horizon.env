# Horizon configuration (docs/operations.md#configuration). Every variable
# below is required; startup lists the missing or invalid ones.

HORIZON_DATABASE_URL=postgres://horizon:CHANGE_ME@localhost:5432/horizon?sslmode=disable
HORIZON_NATS_URL=nats://localhost:4222

HORIZON_S3_ENDPOINT=http://localhost:9000
HORIZON_S3_BUCKET=horizon
HORIZON_S3_ACCESS_KEY=
HORIZON_S3_SECRET_KEY=
#HORIZON_S3_REGION=us-east-1
#HORIZON_S3_PUBLIC_ENDPOINT=

HORIZON_SMTP_URL=smtp://user:pass@localhost:587
HORIZON_SMTP_FROM=horizon@example.com

HORIZON_BASE_URL=https://horizon.example.com
# openssl rand -base64 32
HORIZON_SECRET_KEY=
# At least 32 characters: openssl rand -base64 48
HORIZON_SESSION_SECRET=

#HORIZON_HTTP_ADDR=:8080
#HORIZON_METRICS_ADDR=:9090
#HORIZON_LOG_LEVEL=info
#HORIZON_LOG_FORMAT=json
#HORIZON_TRUSTED_PROXIES=
